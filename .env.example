# ── LLM Provider ───────────────────────────────────────────────────────────────
# Choose one: "gemini" | "groq" | "local"
PROVIDER=groq

# ── Gemini (default, free tier) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq (generous free tier, fast) ─────────────────────────────────────────
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Default Groq model (llama-3.3-70b-versatile is free and very capable)
# Other options: llama3-8b-8192, mixtral-8x7b-32768, llama-3.1-8b-instant
MODEL=llama-3.3-70b-versatile

# ── Local / LM Studio ───────────────────────────────────────────────────────
# Download LM Studio from https://lmstudio.ai, load a model, start the server
# LM_STUDIO_URL=http://localhost:1234/v1
# PROVIDER=local
# MODEL=llama-3.2-3b-instruct
